{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        // Plain promise code that the host loads as is, so the Effect platform rules do not apply.
        "diagnosticSeverity": {
          "nodeBuiltinImport": "off",
          "globalDate": "off",
          "globalTimers": "off"
        }
      }
    ]
  },
  "include": ["src"]
}
